{"protocols":[{"libraryConstructionApproach":["CITE-seq"],"nucleicAcidSource":["single cell"]},{"instrumentManufacturerModel":["Illumina NovaSeq 6000"],"pairedEnd":[false]}],"entryId":"efea6426-510a-4b60-9a19-277e52bfa815","sources":[{"sourceId":"66306883-0e6c-4acb-8027-172ef9291eeb","sourceSpec":"tdr:bigquery:gcp:datarepo-8eb1f82a:hca_prod_efea6426510a4b609a19277e52bfa815__20220118_dcp2_20250514_dcp49","sourcePrefix":"/0"}],"projects":[{"projectId":"efea6426-510a-4b60-9a19-277e52bfa815","projectTitle":"Dissecting the protein and transcriptional responses of human immune cells to T cell and monocyte specific activation","projectShortname":"CITEseqPBMCProject","laboratory":["Adam Williams Lab","Duygu Ucar Lab","Gale and Ira Drukier Institute for Children's Health","Human Cell Atlas Data Coordination Platform","Human Cell Atlas Data coordination Platform","Jacques Banchereau Lab","Michael Stitzel Lab","Technology Innovation Lab"],"estimatedCellCount":250000,"isTissueAtlasProject":false,"tissueAtlas":[],"bionetworkName":[null],"dataUseRestriction":"NRES","duosId":null,"projectDescription":"Single cell profiling is a powerful tool for studying the molecular and cellular (dys)function of activated peripheral blood mononuclear cells (PBMCs) in the context of disease. We combined CITE-seq with two levels of multiplexing (cell hashing and individuals\u2019 genotypes) to derive a reference database of immune cell gene/protein responses to different activation conditions. PBMCs from 10 healthy adults were profiled before and after stimulating i) T cells via anti-CD3/CD28 or ii) monocytes via LPS. By using a comprehensive antibody panel (n=39) of cell type (e.g., CD16, CD14) and cell state (e.g., CD69, CD25) markers, we discovered that all lymphocytes responded to anti-CD3/CD28 stimulation, whereas LPS specifically induced inflammation in monocytes. Pseudo-temporal analyses further revealed cell- and condition-specific heterogeneity in responses to activation that were independent of individual-specific variation. Together, these data are shared within an interactive web application (https://czi-pbmc-cite-seq.jax.org/) and will serve as a resource to guide future studies of immune cell responses.\n","contributors":[{"institution":"The Jackson Laboratory","contactName":"Nathan,,Lawlor","projectRole":"computational scientist","laboratory":"Michael Stitzel Lab","correspondingContributor":true,"email":"nathan.lawlor@jax.org"},{"institution":"The Jackson Laboratory","contactName":"Djamel,,Nehar-Belaid","projectRole":"computational scientist","laboratory":"Jacques Banchereau Lab","correspondingContributor":false,"email":"Djamel.Nehar-belaid@jax.org"},{"institution":"The Jackson Laboratory","contactName":"Jessica,,Grassmann","projectRole":"experimental scientist","laboratory":"Adam Williams Lab","correspondingContributor":false,"email":"Jessica.Grassmann@jax.org"},{"institution":"The New York Genome Center","contactName":"Marlon,,Stoeckius","projectRole":"experimental scientist","laboratory":"Technology Innovation Lab","correspondingContributor":false,"email":"marlon@stoeckius.de"},{"institution":"The New York Genome Center","contactName":"Peter,,Smibert","projectRole":"principal investigator","laboratory":"Technology Innovation Lab","correspondingContributor":false,"email":"psmibert@NYGENOME.ORG"},{"institution":"The Jackson Laboratory","contactName":"Michael,,Stitzel","projectRole":"principal investigator","laboratory":"Michael Stitzel Lab","correspondingContributor":false,"email":"Michael.Stitzel@jax.org"},{"institution":"Weill Cornell Medicine","contactName":"Virginia,,Pascual","projectRole":"principal investigator","laboratory":"Gale and Ira Drukier Institute for Children's Health","correspondingContributor":false,"email":"vip2021@med.cornell.edu"},{"institution":"The Jackson Laboratory","contactName":"Jacques,,Banchereau","projectRole":"principal investigator","laboratory":"Jacques Banchereau Lab","correspondingContributor":false,"email":"Jacques.Banchereau@jax.org"},{"institution":"The Jackson Laboratory","contactName":"Adam,,Williams","projectRole":"principal investigator","laboratory":"Adam Williams Lab","correspondingContributor":true,"email":"Adam.Williams@jax.org"},{"institution":"The Jackson Laboratory","contactName":"Duygu,,Ucar","projectRole":"principal investigator","laboratory":"Duygu Ucar Lab","correspondingContributor":true,"email":"Duygu.Ucar@jax.org"},{"institution":"EMBL-EBI","contactName":"ami,,Day","projectRole":"data curator","laboratory":"Human Cell Atlas Data coordination Platform","correspondingContributor":false,"email":"ami-day@ebi.ac.uk"},{"institution":"EMBL-EBI","contactName":"Enrique,,Sapena Ventura","projectRole":"data curator","laboratory":"Human Cell Atlas Data coordination Platform","correspondingContributor":false,"email":"enrique@ebi.ac.uk"},{"institution":"EMBL-EBI","contactName":"Ray,,Stefancsik","projectRole":"data curator","laboratory":"Human Cell Atlas Data coordination Platform","correspondingContributor":false,"email":"ray@ebi.ac.uk"},{"institution":"EMBL-EBI","contactName":"Marion,F,Shadbolt","projectRole":"data curator","laboratory":"Human Cell Atlas Data Coordination Platform","correspondingContributor":false,"email":"mshadbolt@ebi.ac.uk"}],"publications":[{"publicationTitle":"Single Cell Analysis of Blood Mononuclear Cells Stimulated Through Either LPS or Anti-CD3 and Anti-CD28","officialHcaPublication":false,"publicationUrl":"https://doi.org/10.3389/fimmu.2021.636720","doi":"10.3389/fimmu.2021.636720"}],"supplementaryLinks":["https://czi-pbmc-cite-seq.jax.org/"],"matrices":{},"contributedAnalyses":{"genusSpecies":{"Homo sapiens":{"developmentStage":{"adult":{"organ":{"blood":{"libraryConstructionApproach":{"10x 3' v2 sequencing":[{"contentDescription":["Matrix"],"format":"Rds","isIntermediate":false,"name":"CZI.PBMC.RNA.matrix.Rds","sha256":"c6c1b29e8737085d89f2af35c23fb9ce0e189369e65061f18cfe8532bd1e80c5","size":480584213,"fileSource":"Contributor","uui